# ============================================================================
# DataScope – Enterprise Data Discovery & Intelligence Platform (.env.example)
# ============================================================================

# --- Backend (apps/api/.env) ---
NODE_ENV=development
PORT=4000

# Managed Cloud PostgreSQL Connection String (Neon Direct URI or Pooled URI, Supabase, Aiven, RDS)
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/datascope?sslmode=require"
DATABASE_POOL_MAX=10

# Custom JWT + HttpOnly Cookie Authentication
JWT_ACCESS_SECRET="datascope-dev-access-secret-change-in-production-64-characters-min"
JWT_REFRESH_SECRET="datascope-dev-refresh-secret-change-in-production-64-characters-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# CORS Allowed Frontend Origin (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000"

# --- Frontend (apps/web/.env.local) ---
# Local dev: direct API URL; Vercel proxy production: set NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Server-side & Next.js /api/v1/* rewrite destination (e.g. https://datascope-api.onrender.com/api/v1)
INTERNAL_API_URL="http://localhost:4000/api/v1"
# Must match backend JWT_ACCESS_SECRET so Next.js Edge Middleware can verify auth cookies
JWT_ACCESS_SECRET="datascope-dev-access-secret-change-in-production-64-characters-min"
